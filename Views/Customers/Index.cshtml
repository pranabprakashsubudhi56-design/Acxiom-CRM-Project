@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Customer Management</h2>
        <p class="text-muted mb-0">Manage customer master data, contacts, and track relationship history.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus-fill me-1"></i> Add New Customer
        </a>
    </div>
</div>

<!-- Search and Filter Bar (Section 17.13) -->
<div class="crm-card p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search by name, email, phone, company, or code..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-filter"></i> Filter
            </button>
        </div>
        <div class="col-12 col-md-2 text-md-end">
            <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
        </div>
    </form>
</div>

<!-- Customer Data Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>Customer Code</th>
                    <th>Customer Name</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Company</th>
                    <th>Status</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-primary border fw-bold">@item.CustomerCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.CustomerId" class="fw-bold text-decoration-none text-dark">
                                    @item.CustomerName
                                </a>
                            </td>
                            <td>
                                <a href="mailto:@item.Email" class="text-decoration-none text-muted">
                                    <i class="bi bi-envelope me-1"></i>@item.Email
                                </a>
                            </td>
                            <td>
                                <i class="bi bi-telephone me-1 text-muted"></i>@item.Phone
                            </td>
                            <td>@(item.CompanyName ?? "—")</td>
                            <td>
                                <span class="badge @(item.Status == "Active" ? "badge-subtle-success" : "badge-subtle-danger")">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">@(item.Owner?.FullName ?? "Unassigned")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.CustomerId" class="btn btn-outline-secondary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.CustomerId" class="btn btn-outline-primary" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                    {
                                        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.CustomerId" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteModal-@item.CustomerId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title fw-bold">Confirm Deletion</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body text-start py-3">
                                                Are you sure you want to delete customer <strong>@item.CustomerName</strong> (@item.CustomerCode)?
                                                This action is permanent and will be recorded in the security audit log.
                                            </div>
                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                <form asp-action="Delete" asp-route-id="@item.CustomerId" method="post">
                                                    <button type="submit" class="btn btn-sm btn-danger">Confirm Delete</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-muted"></i>
                            No customer records found matching the criteria.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination Controls -->
    @if (totalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">Showing page @currentPage of @totalPages (@totalItems total items)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">Previous</a>
                </li>
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">@p</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-search="@ViewBag.Search" asp-route-status="@ViewBag.Status">Next</a>
                </li>
            </ul>
        </div>
    }
</div>
