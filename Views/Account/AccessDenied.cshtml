@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="col-md-6 text-center">
        <div class="crm-card p-5 shadow-sm">
            <div class="d-inline-flex p-3 rounded-circle bg-danger bg-opacity-10 text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied (403)</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions to view or perform operations on this resource.
                If you believe this is in error, please contact your System Administrator.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4">
                    <i class="bi bi-speedometer2 me-1"></i> Return to Dashboard
                </a>
                <a href="javascript:history.back()" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left me-1"></i> Go Back
                </a>
            </div>
        </div>
    </div>
</div>
