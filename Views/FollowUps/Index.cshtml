@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    string currentFilter = ViewBag.Filter ?? "all";
    DateTime now = DateTime.UtcNow;
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Follow-Up Management</h2>
        <p class="text-muted mb-0">Schedule reminders, manage appointments, and track client interactions.</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Tab Navigation Filters (Section 4.6 & 17.13) -->
<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="btn-group shadow-sm" role="group">
        <a asp-action="Index" asp-route-filter="all" class="btn btn-sm @(currentFilter == "all" ? "btn-primary" : "btn-outline-secondary")">All Activities</a>
        <a asp-action="Index" asp-route-filter="upcoming" class="btn btn-sm @(currentFilter == "upcoming" ? "btn-primary" : "btn-outline-secondary")">Upcoming</a>
        <a asp-action="Index" asp-route-filter="today" class="btn btn-sm @(currentFilter == "today" ? "btn-primary" : "btn-outline-secondary")">Scheduled Today</a>
        <a asp-action="Index" asp-route-filter="overdue" class="btn btn-sm @(currentFilter == "overdue" ? "btn-danger" : "btn-outline-danger")">Overdue</a>
        <a asp-action="Index" asp-route-filter="completed" class="btn btn-sm @(currentFilter == "completed" ? "btn-success" : "btn-outline-secondary")">Completed</a>
    </div>
</div>

<!-- Follow-Ups Table -->
<div class="crm-card">
    <div class="table-responsive">
        <table class="table table-modern mb-0">
            <thead>
                <tr>
                    <th>Subject</th>
                    <th>Associated With</th>
                    <th>Type</th>
                    <th>Follow-Up Date & Time</th>
                    <th>Status</th>
                    <th>Assigned To</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        bool isOverdue = item.Status == "Planned" && item.FollowUpDate < now;
                        <tr>
                            <td>
                                <div class="fw-bold">@item.Subject</div>
                                @if (!string.IsNullOrEmpty(item.Remarks))
                                {
                                    <small class="text-muted">@item.Remarks</small>
                                }
                            </td>
                            <td>
                                @if (item.Customer != null)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.CustomerId" class="text-decoration-none">
                                        <i class="bi bi-building me-1"></i>@item.Customer.CustomerName
                                    </a>
                                }
                                else if (item.Lead != null)
                                {
                                    <a asp-controller="Leads" asp-action="Details" asp-route-id="@item.LeadId" class="text-decoration-none">
                                        <i class="bi bi-funnel me-1"></i>@item.Lead.LeadName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">
                                    @item.FollowUpType
                                </span>
                            </td>
                            <td>
                                <span class="@(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                    <i class="bi bi-clock me-1"></i>@item.FollowUpDate.ToString("g")
                                </span>
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(item.Status == "Completed" ? "badge-subtle-success" : (item.Status == "Planned" ? "badge-subtle-warning" : "badge-subtle-danger"))">
                                    @item.Status
                                </span>
                            </td>
                            <td>
                                <small class="text-muted">@(item.AssignedUser?.FullName ?? "Unassigned")</small>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    @if (item.Status == "Planned")
                                    {
                                        <button type="button" class="btn btn-outline-success" data-bs-toggle="modal" data-bs-target="#completeModal-@item.FollowUpId" title="Mark Done">
                                            <i class="bi bi-check2"></i> Done
                                        </button>
                                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@item.FollowUpId" title="Reschedule">
                                            <i class="bi bi-clock-history"></i>
                                        </button>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up?');">
                                        <button type="submit" class="btn btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>

                                <!-- Complete Modal -->
                                <div class="modal fade" id="completeModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <form asp-action="Complete" asp-route-id="@item.FollowUpId" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Complete Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p>Mark <strong>@item.Subject</strong> as completed.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label">Completion Remarks / Outcome</label>
                                                        <textarea name="remarks" class="form-control" rows="3" placeholder="Key meeting notes, next steps..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-success">Mark Completed</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Reschedule Modal -->
                                <div class="modal fade" id="rescheduleModal-@item.FollowUpId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content text-start">
                                            <form asp-action="Reschedule" asp-route-id="@item.FollowUpId" method="post">
                                                <div class="modal-header">
                                                    <h5 class="modal-title fw-bold">Reschedule Follow-Up</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="mb-3">
                                                        <label class="form-label">New Follow-Up Date & Time <span class="text-danger">*</span></label>
                                                        <input type="datetime-local" name="newDate" class="form-control" required />
                                                        <span class="form-text small text-muted">Cannot be earlier than today.</span>
                                                    </div>
                                                    <div class="mb-3">
                                                        <label class="form-label">Reschedule Reason</label>
                                                        <textarea name="remarks" class="form-control" rows="2" placeholder="Client requested later time..."></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-sm btn-light" data-bs-dismiss="modal">Cancel</button>
                                                    <button type="submit" class="btn btn-sm btn-primary">Save New Date</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-muted"></i>
                            No follow-up activities found in this view.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
