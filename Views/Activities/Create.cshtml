@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="crm-card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1">Log Client Activity</h3>
                    <p class="text-muted small mb-0">Record a call summary, client meeting, email interaction, or completed task.</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back
                </a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ActivityType" class="form-label">Activity Type <span class="text-danger">*</span></label>
                        <select asp-for="ActivityType" class="form-select">
                            <option value="Call">Call</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Email">Email</option>
                            <option value="Task">Task</option>
                        </select>
                        <span asp-validation-for="ActivityType" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="ActivityDate" class="form-label">Activity Date & Time <span class="text-danger">*</span></label>
                        <input asp-for="ActivityDate" class="form-control" type="datetime-local" />
                        <span asp-validation-for="ActivityDate" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Subject" class="form-label">Subject / Key Outcome <span class="text-danger">*</span></label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Discussed pilot pricing structure" />
                        <span asp-validation-for="Subject" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerId" class="form-label">Customer Account</label>
                        <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers">
                            <option value="">-- None / Select Customer --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="LeadId" class="form-label">Lead (Optional)</label>
                        <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads">
                            <option value="">-- None / Select Lead --</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Completed">Completed</option>
                            <option value="Planned">Planned</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="AssignedTo" class="form-label">Logged By</label>
                        <select asp-for="AssignedTo" class="form-select" asp-items="ViewBag.Users">
                            <option value="">-- Current User --</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Detailed Notes / Minutes</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Summary of talking points, objections raised, agreed action items..."></textarea>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Save Activity
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
