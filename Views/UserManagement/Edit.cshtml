@model AcxiomCRM.ViewModels.EditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="crm-card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1">Edit User: @Model.FullName</h3>
                    <p class="text-muted small mb-0">Update profile information, modify role assignment, or reset password.</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Users
                </a>
            </div>

            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address</label>
                    <input asp-for="Email" class="form-control bg-light" readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Assigned Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="SalesExecutive">Sales Executive</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Administrator</option>
                    </select>
                </div>

                <div class="mb-3 form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" id="activeSwitch" />
                    <label class="form-check-label fw-semibold" for="activeSwitch">Account Active</label>
                    <div class="form-text small text-muted">Inactive users are prohibited from signing into the system.</div>
                </div>

                <div class="p-3 mb-4 rounded bg-light border">
                    <label asp-for="NewPassword" class="form-label fw-bold">Reset Password (Optional)</label>
                    <input asp-for="NewPassword" class="form-control" placeholder="Leave blank to keep existing password" />
                    <span class="form-text small text-muted">If specified, must satisfy minimum 8 characters and complexity rules.</span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-save me-1"></i> Update User Profile
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
