@model AcxiomCRM.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Create System User";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <div class="crm-card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <h3 class="fw-bold mb-1">Create System User</h3>
                    <p class="text-muted small mb-0">Add a new authenticated user and assign security role.</p>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Back to Users
                </a>
            </div>

            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">Full Name <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" placeholder="e.g. Rachel Adams" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="user@acxiomcrm.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label">Assigned Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select">
                        <option value="SalesExecutive">Sales Executive (Scoped to assigned records)</option>
                        <option value="Manager">Manager (Team visibility & reports)</option>
                        <option value="Admin">Administrator (Full system administration)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label">Initial Password <span class="text-danger">*</span></label>
                    <input asp-for="Password" class="form-control" placeholder="Min 8 characters with complexity" />
                    <span class="form-text small text-muted">Password must contain at least 8 characters, uppercase, lowercase, digit, and symbol.</span>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        <i class="bi bi-person-check-fill me-1"></i> Create User
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
