@using Microsoft.AspNetCore.Identity
@using AcxiomCRM.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var roleBadgeClass = User.IsInRole("Admin") ? "bg-danger" : (User.IsInRole("Manager") ? "bg-warning text-dark" : "bg-primary");
    var roleName = User.IsInRole("Admin") ? "Admin" : (User.IsInRole("Manager") ? "Manager" : "Sales Executive");

    <li class="nav-item me-2">
        <span class="badge @roleBadgeClass px-2 py-1 fs-8 text-uppercase">@roleName</span>
    </li>
    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle text-dark fw-semibold d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <span class="avatar-circle me-1">@(currentUser?.FullName?.Length > 0 ? currentUser.FullName[0].ToString().ToUpper() : "U")</span>
            <span>@(currentUser?.FullName ?? User.Identity?.Name)</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
            <li class="dropdown-header">Signed in as <strong>@User.Identity?.Name</strong></li>
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="px-2 py-1" asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="dropdown-item text-danger d-flex align-items-center">
                        <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium" asp-controller="Account" asp-action="Register">
            <i class="bi bi-person-plus me-1"></i> Register
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary btn-sm ms-2 px-3 rounded-pill fw-medium" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
        </a>
    </li>
}
</ul>
