<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AcxiomCRM</title>
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Custom Modern Theme -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg app-navbar sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <span class="brand-badge"><i class="bi bi-diagram-3-fill"></i> CRM</span>
                    <span>AcxiomCRM</span>
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#crmNavbar" aria-controls="crmNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="crmNavbar">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customers" asp-action="Index">
                                    <i class="bi bi-people-fill"></i> Customers
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Leads" asp-action="Index">
                                    <i class="bi bi-funnel-fill"></i> Leads
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Opportunities" asp-action="Index">
                                    <i class="bi bi-briefcase-fill"></i> Opportunities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="FollowUps" asp-action="Index">
                                    <i class="bi bi-calendar-check-fill"></i> Follow-Ups
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Activities" asp-action="Index">
                                    <i class="bi bi-clock-history"></i> Activities
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reports" asp-action="Index">
                                    <i class="bi bi-bar-chart-line-fill"></i> Reports
                                </a>
                            </li>
                            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-shield-lock-fill"></i> Administration
                                    </a>
                                    <ul class="dropdown-menu shadow-sm border-0" aria-labelledby="adminDropdown">
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="UserManagement" asp-action="Index">
                                                <i class="bi bi-person-gear me-2 text-primary"></i> User & Role Management
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" asp-controller="AuditLogs" asp-action="Index">
                                                <i class="bi bi-journal-text me-2 text-info"></i> Security & Audit Trail
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item py-2" href="/swagger" target="_blank">
                                                <i class="bi bi-code-slash me-2 text-success"></i> REST API Documentation (Swagger)
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav me-auto"></ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-lg-4 py-3 flex-grow-1">
        <!-- Toast / Alerts -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="crm-footer text-center">
        <div class="container-fluid px-4 d-flex flex-column flex-sm-row justify-content-between align-items-center">
            <div>
                &copy; 2026 <strong>AcxiomCRM</strong>. Enterprise Customer Relationship Management System.
            </div>
            <div class="mt-2 mt-sm-0">
                <span class="badge bg-light text-dark border me-2"><i class="bi bi-shield-check text-success"></i> Identity Sec-Lock</span>
                <span class="badge bg-light text-dark border me-2"><i class="bi bi-database-check text-primary"></i> EF Core SQLite</span>
                <a href="/swagger" target="_blank" class="text-decoration-none text-muted"><i class="bi bi-file-earmark-code"></i> API Docs</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
