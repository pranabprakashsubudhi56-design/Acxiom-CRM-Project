@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = $"Lead Profile: {Model.LeadName}";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <div class="d-flex align-items-center gap-2 mb-1">
            <span class="badge bg-light text-primary border fw-bold fs-7">@Model.LeadCode</span>
            <h2 class="fw-bold mb-0">@Model.LeadName</h2>
            <span class="badge @(Model.Status == "Converted" ? "bg-success" : (Model.Status == "Qualified" ? "bg-primary" : "bg-warning text-dark"))">
                @Model.Status
            </span>
            <span class="badge @(Model.Priority == "High" ? "bg-danger" : "bg-secondary")">
                @Model.Priority Priority
            </span>
        </div>
        <p class="text-muted mb-0">@(Model.CompanyName ?? "Prospect") &bull; Assigned to <strong>@(Model.AssignedUser?.FullName ?? "Unassigned")</strong></p>
    </div>
    <div class="d-flex gap-2">
        @if (Model.Status != "Converted")
        {
            <a asp-action="Convert" asp-route-id="@Model.LeadId" class="btn btn-success shadow-sm">
                <i class="bi bi-arrow-repeat me-1"></i> Convert to Customer
            </a>
        }
        else if (Model.CustomerId.HasValue)
        {
            <a asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-success">
                <i class="bi bi-person-check me-1"></i> View Converted Customer
            </a>
        }
        <a asp-action="Edit" asp-route-id="@Model.LeadId" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-4">
        <div class="crm-card p-4 mb-4">
            <h5 class="fw-bold mb-3 border-bottom pb-2"><i class="bi bi-info-circle text-primary me-2"></i> Lead Details</h5>
            
            <div class="mb-3">
                <label class="text-muted small fw-semibold">Email Address</label>
                <div class="fw-medium">
                    <a href="mailto:@Model.Email" class="text-decoration-none">
                        <i class="bi bi-envelope me-1 text-primary"></i>@Model.Email
                    </a>
                </div>
            </div>

            <div class="mb-3">
                <label class="text-muted small fw-semibold">Phone Number</label>
                <div class="fw-medium">
                    <i class="bi bi-telephone me-1 text-success"></i>@Model.Phone
                </div>
            </div>

            <div class="mb-3">
                <label class="text-muted small fw-semibold">Lead Source</label>
                <div class="fw-medium">
                    <span class="badge bg-light text-dark border">@Model.Source</span>
                </div>
            </div>

            <div class="mb-3">
                <label class="text-muted small fw-semibold">Expected Deal Value</label>
                <div class="fw-bold text-success fs-5">
                    @Model.ExpectedValue.ToString("C0")
                </div>
            </div>

            <div class="pt-3 border-top mt-3 small text-muted">
                <div>Created: <strong>@Model.CreatedDate.ToString("g")</strong></div>
            </div>
        </div>

        <div class="crm-card p-3">
            <h6 class="fw-bold mb-3"><i class="bi bi-lightning-charge text-warning me-2"></i> Quick Actions</h6>
            <div class="d-grid gap-2">
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-primary text-start">
                    <i class="bi bi-calendar-plus me-2"></i> Schedule Follow-Up
                </a>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-info text-start">
                    <i class="bi bi-telephone-plus me-2"></i> Log Activity
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8">
        <!-- Follow-Ups for this lead -->
        <div class="crm-card mb-4">
            <div class="card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-calendar-check text-success me-2"></i> Follow-Ups (@Model.FollowUps.Count)</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-success">
                    <i class="bi bi-plus"></i> Schedule
                </a>
            </div>
            <div class="table-responsive">
                <table class="table table-modern mb-0">
                    <thead>
                        <tr>
                            <th>Subject</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.FollowUps.Any())
                        {
                            foreach (var f in Model.FollowUps)
                            {
                                <tr>
                                    <td class="fw-medium">@f.Subject</td>
                                    <td>@f.FollowUpDate.ToString("g")</td>
                                    <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                                    <td><span class="badge bg-light text-dark border">@f.Status</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="4" class="text-center py-4 text-muted">No follow-ups recorded yet.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Activities for this lead -->
        <div class="crm-card">
            <div class="card-header-clean">
                <h6 class="fw-bold mb-0"><i class="bi bi-clock-history text-info me-2"></i> Activity Log (@Model.Activities.Count)</h6>
                <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@Model.LeadId" class="btn btn-sm btn-outline-info">
                    <i class="bi bi-plus"></i> Log Activity
                </a>
            </div>
            <div class="p-3">
                @if (Model.Activities.Any())
                {
                    foreach (var a in Model.Activities)
                    {
                        <div class="p-3 mb-2 bg-light rounded border">
                            <div class="d-flex justify-content-between">
                                <span class="fw-bold"><span class="badge bg-secondary me-2">@a.ActivityType</span>@a.Subject</span>
                                <small class="text-muted">@a.ActivityDate.ToString("g")</small>
                            </div>
                            <div class="text-muted small mt-1">@(a.Description ?? "No description.")</div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-4 text-muted">No activities logged yet.</div>
                }
            </div>
        </div>
    </div>
</div>
