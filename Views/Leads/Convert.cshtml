@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead to Customer";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="crm-card shadow-sm p-4">
            <div class="d-flex justify-content-between align-items-center pb-3 mb-4 border-bottom">
                <div>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold mb-1">
                        <i class="bi bi-arrow-repeat me-1"></i> Conversion Workflow
                    </span>
                    <h3 class="fw-bold mb-0">Convert Lead: @Model.LeadName</h3>
                    <p class="text-muted small mb-0">Converting this lead creates an official Customer Account and optionally an initial Opportunity.</p>
                </div>
                <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
            </div>

            <form asp-action="Convert" method="post">
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadCode" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small" role="alert"></div>

                <!-- Section 1: Customer Account Information -->
                <div class="p-3 mb-4 rounded bg-light border">
                    <h6 class="fw-bold mb-3 text-primary"><i class="bi bi-person-badge me-2"></i> 1. Customer Account Details</h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="LeadName" class="form-label">Customer Name</label>
                            <input asp-for="LeadName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label">Company Name</label>
                            <input asp-for="CompanyName" class="form-control" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label">Email Address <span class="text-danger">*</span></label>
                            <input asp-for="Email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label">Phone Number (10 Digits) <span class="text-danger">*</span></label>
                            <input asp-for="Phone" class="form-control" maxlength="10" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Opportunity Options -->
                <div class="p-3 mb-4 rounded bg-light border">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-success"><i class="bi bi-briefcase me-2"></i> 2. Sales Opportunity Creation</h6>
                        <div class="form-check form-switch">
                            <input asp-for="CreateOpportunity" class="form-check-input" type="checkbox" id="toggleOpp" checked />
                            <label class="form-check-label small fw-semibold" for="toggleOpp">Create Opportunity</label>
                        </div>
                    </div>

                    <div id="oppFields" class="row g-3">
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label">Opportunity Name <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityName" class="form-control" />
                            <span asp-validation-for="OpportunityName" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="OpportunityAmount" class="form-label">Deal Amount ($) <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityAmount" class="form-control" type="number" step="100" min="0.01" />
                            <span asp-validation-for="OpportunityAmount" class="text-danger"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Stage" class="form-label">Initial Stage</label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Probability" class="form-label">Win Probability (%)</label>
                            <input asp-for="Probability" class="form-control" type="number" min="0" max="100" />
                            <span asp-validation-for="Probability" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" class="form-control" type="date" />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-success px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-all me-1"></i> Confirm & Complete Conversion
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('toggleOpp').addEventListener('change', function () {
            document.getElementById('oppFields').style.display = this.checked ? 'flex' : 'none';
        });
    </script>
}
