@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Sales Opportunities";
    string viewMode = ViewBag.ViewMode ?? "pipeline";
    decimal totalPipeline = ViewBag.TotalPipeline ?? 0m;
    decimal weightedPipeline = ViewBag.WeightedPipeline ?? 0m;
    int totalCount = ViewBag.TotalCount ?? 0;
    var stages = new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" };
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">Sales Opportunities & Pipeline</h2>
        <p class="text-muted mb-0">Track active deals through the sales cycle with weighted revenue forecasts.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group shadow-sm" role="group">
            <a asp-action="Index" asp-route-viewMode="pipeline" asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status" class="btn btn-sm @(viewMode == "pipeline" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-kanban"></i> Pipeline Board
            </a>
            <a asp-action="Index" asp-route-viewMode="table" asp-route-stage="@ViewBag.Stage" asp-route-status="@ViewBag.Status" class="btn btn-sm @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")">
                <i class="bi bi-table"></i> Table View
            </a>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> New Opportunity
        </a>
    </div>
</div>

<!-- Pipeline KPI Summary Strip -->
<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="crm-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted text-uppercase fw-bold">Active Pipeline Value</small>
                <div class="fs-4 fw-bold text-primary">@totalPipeline.ToString("C0")</div>
            </div>
            <div class="kpi-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="bi bi-cash-coin"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="crm-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted text-uppercase fw-bold">Weighted Forecast (Prob. Adj.)</small>
                <div class="fs-4 fw-bold text-success">@weightedPipeline.ToString("C0")</div>
            </div>
            <div class="kpi-icon-box bg-success bg-opacity-10 text-success">
                <i class="bi bi-graph-up"></i>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-4">
        <div class="crm-card p-3 d-flex align-items-center justify-content-between">
            <div>
                <small class="text-muted text-uppercase fw-bold">Total Deals in Scope</small>
                <div class="fs-4 fw-bold text-dark">@totalCount</div>
            </div>
            <div class="kpi-icon-box bg-secondary bg-opacity-10 text-dark">
                <i class="bi bi-briefcase"></i>
            </div>
        </div>
    </div>
</div>

<!-- Search & Stage Filter Bar -->
<div class="crm-card p-3 mb-4">
    <form asp-action="Index" method="get" class="row g-2 align-items-center">
        <input type="hidden" name="viewMode" value="@viewMode" />
        <div class="col-12 col-md-5">
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control border-start-0" placeholder="Search opportunity name or customer..." />
            </div>
        </div>
        <div class="col-6 col-md-3">
            <select name="stage" class="form-select">
                <option value="">All Stages</option>
                @foreach (var s in stages)
                {
                    <option value="@s" selected="@(ViewBag.Stage == s)">@s</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <select name="status" class="form-select">
                <option value="">All Statuses</option>
                <option value="Open" selected="@(ViewBag.Status == "Open")">Open</option>
                <option value="Won" selected="@(ViewBag.Status == "Won")">Won</option>
                <option value="Lost" selected="@(ViewBag.Status == "Lost")">Lost</option>
            </select>
        </div>
        <div class="col-12 col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Filter</button>
            <a asp-action="Index" asp-route-viewMode="@viewMode" class="btn btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

@if (viewMode == "pipeline")
{
    <!-- 1. Pipeline Kanban Board -->
    <div class="kanban-board">
        @foreach (var stageName in stages)
        {
            var stageDeals = Model.Where(o => o.Stage == stageName).ToList();
            var stageTotal = stageDeals.Sum(o => o.Amount);

            <div class="kanban-column">
                <div class="kanban-column-header">
                    <div>
                        <span class="text-uppercase">@stageName</span>
                        <span class="badge bg-secondary ms-1">@stageDeals.Count</span>
                    </div>
                    <span class="fw-bold small text-muted">@stageTotal.ToString("C0")</span>
                </div>

                <div class="kanban-cards-container flex-grow-1">
                    @if (stageDeals.Any())
                    {
                        foreach (var opp in stageDeals)
                        {
                            <div class="kanban-card">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <a asp-action="Details" asp-route-id="@opp.OpportunityId" class="fw-bold text-dark text-decoration-none small">
                                        @opp.OpportunityName
                                    </a>
                                </div>
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-building me-1"></i>@(opp.Customer?.CustomerName ?? "Prospect")
                                </div>
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="fw-bold text-success">@opp.Amount.ToString("C0")</span>
                                    <span class="badge bg-light text-dark border">@opp.Probability%</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2 border-top small text-muted">
                                    <span><i class="bi bi-clock me-1"></i>@opp.ExpectedCloseDate.ToString("MMM dd")</span>
                                    <span>@(opp.AssignedUser?.FullName?.Split(' ')[0] ?? "—")</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted small">No deals in this stage.</div>
                    }
                </div>
            </div>
        }
    </div>
}
else
{
    <!-- 2. Traditional Data Table -->
    <div class="crm-card">
        <div class="table-responsive">
            <table class="table table-modern mb-0">
                <thead>
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                        <th>Status</th>
                        <th>Owner</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Details" asp-route-id="@item.OpportunityId" class="fw-bold text-dark text-decoration-none">
                                        @item.OpportunityName
                                    </a>
                                </td>
                                <td>@(item.Customer?.CustomerName ?? "—")</td>
                                <td class="fw-bold text-success">@item.Amount.ToString("C0")</td>
                                <td><span class="badge bg-primary">@item.Stage</span></td>
                                <td>@item.Probability%</td>
                                <td class="fw-semibold text-muted">@item.WeightedValue.ToString("C0")</td>
                                <td>@item.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <span class="badge @(item.Status == "Won" ? "badge-subtle-success" : (item.Status == "Lost" ? "badge-subtle-danger" : "badge-subtle-primary"))">
                                        @item.Status
                                    </span>
                                </td>
                                <td><small class="text-muted">@(item.AssignedUser?.FullName ?? "Unassigned")</small></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@item.OpportunityId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.OpportunityId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                        {
                                            <form asp-action="Delete" asp-route-id="@item.OpportunityId" method="post" class="d-inline" onsubmit="return confirm('Delete this opportunity?');">
                                                <button type="submit" class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5 text-muted">
                                No sales opportunities found matching your filters.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
